{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "groovemap.operations-console-api",
  "operations": {
    "admin_audit_log": {"method": "GET", "path": "/api/admin/audit-log"},
    "admin_dlq_purge": {"method": "POST", "path": "/api/admin/dlq/purge/{queue}"},
    "admin_extraction": {"method": "GET", "path": "/api/admin/extractions/{extraction_id}"},
    "admin_extraction_analysis_compare": {"method": "GET", "path": "/api/admin/extraction-analysis/{version}/compare/{other_version}"},
    "admin_extraction_analysis_generate_ai_prompt": {"method": "POST", "path": "/api/admin/extraction-analysis/{version}/generate-ai-prompt"},
    "admin_extraction_analysis_parsing_errors": {"method": "GET", "path": "/api/admin/extraction-analysis/{version}/parsing-errors"},
    "admin_extraction_analysis_prompt_context": {"method": "POST", "path": "/api/admin/extraction-analysis/{version}/prompt-context"},
    "admin_extraction_analysis_skipped": {"method": "GET", "path": "/api/admin/extraction-analysis/{version}/skipped"},
    "admin_extraction_analysis_summary": {"method": "GET", "path": "/api/admin/extraction-analysis/{version}/summary"},
    "admin_extraction_analysis_versions": {"method": "GET", "path": "/api/admin/extraction-analysis/versions"},
    "admin_extraction_analysis_violation": {"method": "GET", "path": "/api/admin/extraction-analysis/{version}/violations/{record_id}"},
    "admin_extraction_analysis_violations": {"method": "GET", "path": "/api/admin/extraction-analysis/{version}/violations"},
    "admin_extraction_trigger": {
      "method": "POST",
      "path": "/api/admin/extractions/trigger",
      "request_body": {"required": ["source"], "properties": {"source": {"enum": ["discogs", "musicbrainz"], "type": "string"}}},
      "response_fields": ["id", "source", "status"]
    },
    "admin_extractions": {"method": "GET", "path": "/api/admin/extractions", "response_fields_nullable": ["source"]},
    "admin_identity_ledger_density": {"method": "GET", "path": "/api/admin/identity/ledger/density", "query": ["kind"], "kinds": ["release", "master", "artist", "label"], "dated_from": ["groovemap", "musicbrainz_fullexport"], "response_fields": ["buckets", "kind"]},
    "admin_identity_ledger_work": {"method": "GET", "path": "/api/admin/identity/ledger/works/{work_id}", "query": ["as_of", "edition_limit"], "dated_from": ["groovemap", "musicbrainz_fullexport"], "response_fields": ["as_of", "edition_count", "editions", "truncated", "work"]},
    "admin_identity_ledger_works": {"method": "GET", "path": "/api/admin/identity/ledger/works", "query": ["event", "page", "page_size", "since", "until"], "events": ["linked_at_ingest", "reattached", "promoted", "reverted", "evidence_attached", "alias_closed", "link_added", "link_changed", "link_removed"], "response_fields": ["page", "page_size", "total", "works"]},
    "admin_identity_project": {"method": "POST", "path": "/api/admin/identity/project"},
    "admin_login": {"method": "POST", "path": "/api/admin/auth/login"},
    "admin_logout": {"method": "POST", "path": "/api/admin/auth/logout"},
    "admin_session": {"method": "GET", "path": "/api/admin/auth/session"},
    "admin_storage": {"method": "GET", "path": "/api/admin/storage"},
    "admin_sync_activity": {"method": "GET", "path": "/api/admin/users/sync-activity"},
    "admin_unmapped_media": {"method": "GET", "path": "/api/admin/media/unmapped"},
    "admin_user_stats": {"method": "GET", "path": "/api/admin/users/stats"}
  },
  "version": 1
}
