    "fit_release": {"method": "GET", "path": "/api/fit/release/{release_id}"},
    "genre_tree": {"method": "GET", "path": "/api/genre-tree"},
    "graph_stats": {"method": "GET", "path": "/api/graph/stats"},
    "nlq_query": {"method": "POST", "path": "/api/nlq/query"},
